---
import { Image } from 'astro:assets';
import BrandLockup from './BrandLockup.astro';
import { YOUTUBE_URL, TAGLINE } from '../lib/site';
import echoCutout from '../assets/cutouts/echo.png';
---
<header class="hero">
  <div class="hero-copy">
    <BrandLockup />
    <p class="kicker">AI-native media studio — N°001–008</p>
    <h1>Same world.<br />Different questions.</h1>
    <p class="lede">{TAGLINE}</p>
    <div class="actions">
      <a class="cta" href={YOUTUBE_URL} rel="noopener">Subscribe on YouTube →</a>
      <a class="secondary" href="#the-eight">Meet the eight ↓</a>
    </div>
  </div>
  <Image class="hero-figure" src={echoCutout} alt="" height={620} aria-hidden="true" />
</header>

<style>
  .hero {
    position: relative; display: grid; align-items: end;
    grid-template-columns: minmax(0, 1fr) minmax(0, 42%);
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(40px, 7vw, 96px) var(--gutter) 0;
    overflow: hidden;
  }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .hero-figure { display: none; }
  }
  .hero-copy { padding-bottom: clamp(40px, 6vw, 88px); }
  .kicker {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: .24em;
    text-transform: uppercase; color: var(--ink-soft); margin: 26px 0 22px;
  }
  h1 {
    font-family: var(--font-display); font-weight: 700; margin: 0;
    font-size: clamp(48px, 10vw, 128px); line-height: .86;
    letter-spacing: -.04em; text-transform: uppercase;
  }
  .lede { max-width: var(--measure); margin: 26px 0 0; font-size: 18px; line-height: 1.55; color: var(--ink-soft); }
  .actions { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; margin-top: 30px; }
  .cta {
    background: var(--ink); color: var(--bone); padding: 15px 28px; text-decoration: none;
    font-family: var(--font-mono); font-size: 13px; letter-spacing: .16em; text-transform: uppercase;
  }
  .secondary {
    color: var(--ink); font-family: var(--font-mono); font-size: 13px; letter-spacing: .14em;
  }
  .hero-figure { align-self: end; max-height: 62vh; width: auto; height: auto; justify-self: center; }
</style>
