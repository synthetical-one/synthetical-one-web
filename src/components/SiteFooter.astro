---
import { YOUTUBE_URL, CONTACT_EMAIL } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="foot">
  <p class="live"><span class="dot" aria-hidden="true"></span> Synthetical</p>
  <nav>
    <a href={YOUTUBE_URL} rel="noopener">YouTube</a>
    <a href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
  </nav>
  <p class="small">© {year} Synthetical. The eight characters are canon and frozen.</p>
</footer>

<style>
  .foot { background: var(--ink); color: var(--bone); padding: clamp(40px, 6vw, 80px) var(--gutter); --focus-ring: var(--bone); }
  .live { font-family: var(--font-mono); letter-spacing: .18em; text-transform: uppercase; font-size: 13px; margin: 0 0 24px; display: flex; align-items: center; gap: 10px; }
  .dot { width: 10px; height: 10px; background: #3FE08A; display: inline-block; }
  nav { display: flex; gap: 26px; margin-bottom: 26px; }
  nav a { color: var(--bone); font-family: var(--font-mono); font-size: 13px; letter-spacing: .12em; }
  .small { margin: 0; color: #8A909E; font-size: 13px; font-family: var(--font-mono); }
</style>
