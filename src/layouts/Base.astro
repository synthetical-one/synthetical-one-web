---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/motion.css';
import Grain from '../components/Grain.astro';
import { SITE_NAME, SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /**
   * Override the self-referential canonical. Only pages whose own URL is not
   * a real, resolvable address need this — see src/pages/404.astro, which
   * Astro emits as `dist/404.html` (a file, not a `/404/` directory), so a
   * canonical pointing at its own path would name a URL that 404s.
   */
  canonicalPath?: string;
  /** Ask search engines not to index this page (again: the 404). */
  noindex?: boolean;
}
const { title, description, ogImage, canonicalPath, noindex = false } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE_URL).href;
const image = new URL(ogImage ?? '/og-default.png', SITE_URL).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Grain />
    <a class="skip" href="#main">Skip to content</a>
    {/*
      The masthead and footer are siblings of <main>, never descendants of it.
      Per HTML-AAM, <header> maps to the `banner` role and <footer> to
      `contentinfo` only when they are *not* inside <main> (or an article /
      aside / nav / section). Nesting them in the page slot, as an earlier
      version did, collapsed every page to a single `main` landmark, so a
      screen-reader user had no way to jump to the masthead or the footer.
      Pages therefore fill the named `header` / `footer` slots instead of
      rendering those elements inline. The skip link still targets #main.
    */}
    <slot name="header" />
    <main id="main" tabindex="-1"><slot /></main>
    <slot name="footer" />
    <style>
      .skip {
        position: absolute; left: -9999px;
        background: var(--ink); color: var(--bone);
        padding: 12px 18px; font-family: var(--font-mono); font-size: 13px;
      }
      .skip:focus { left: 12px; top: 12px; z-index: 99; }
      :global(a:focus-visible), :global(button:focus-visible) {
        outline: 3px solid var(--focus-ring); outline-offset: 3px;
      }
    </style>
  </body>
</html>
