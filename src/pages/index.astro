---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Premise from '../components/Premise.astro';
import CharacterBand from '../components/CharacterBand.astro';
import WhatWeMake from '../components/WhatWeMake.astro';
import Studio from '../components/Studio.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { TAGLINE } from '../lib/site';
import { getCollection } from 'astro:content';

const characters = (await getCollection('characters')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<Base title="Synthetical — an AI-native media studio" description={TAGLINE}>
  <Hero slot="header" />
  <Premise />
  <section id="the-eight">
    {characters.map((entry) => <CharacterBand entry={entry} />)}
  </section>
  <WhatWeMake />
  <Studio />
  <SiteFooter slot="footer" />
</Base>
